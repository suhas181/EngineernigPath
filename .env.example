# ==========================================
# EngineerPath Environment Configuration
# ==========================================

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/engineerpath?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/engineerpath?retryWrites=true&w=majority

# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# Frontend Configuration (for Vercel or local frontend/.env)
VITE_API_URL=http://localhost:5001/api

# JWT Authentication (Required: Generate long random strings in production)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRATION=7d

# Default Admin Credentials (for `npm run seed:admin`)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@engineerpath.com
ADMIN_PASSWORD=Admin@12345

# Mailer Settings (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@engineerpath.com

# Cloudinary Storage Config (Production Persistent File Storage for Resumes & Profile Images)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google Gemini AI Key (Optional)
GEMINI_API_KEY=your-gemini-api-key
