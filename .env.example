# ==============================================================================
# EngineerPath Fullstack Environment Configuration
# ==============================================================================

# ── 1. BACKEND CORE CONFIGURATION ─────────────────────────────────────────────
# [Dev]: 5001 | [Prod]: Provided by hosting (Render defaults to 10000 or 5001)
PORT=5001

# [Dev]: development | [Prod]: production (enforces secure cookies & strict security)
NODE_ENV=development

# Frontend client URL allowed for CORS origin
# [Dev]: http://localhost:5173 | [Prod]: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Backend URL for absolute asset links & webhooks
# [Dev]: http://localhost:5001 | [Prod]: https://your-backend.onrender.com
BACKEND_URL=http://localhost:5001

# Optional comma-separated CORS origins
# ALLOWED_ORIGINS=https://engineerpath.vercel.app,https://your-custom-domain.com

# ── 2. FRONTEND CONFIGURATION (Vercel / Local) ────────────────────────────────
# Public API base URL consumed by Vite frontend client
# [Dev]: http://localhost:5001/api | [Prod]: https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5001/api

# ── 3. DATABASE (MongoDB Atlas or Local) ──────────────────────────────────────
# Required in production: MongoDB Atlas cluster connection string
# [Dev]: mongodb://127.0.0.1:27017/engineerpath
# [Prod]: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/engineerpath?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/engineerpath?retryWrites=true&w=majority

# ── 4. JWT AUTHENTICATION (Required) ──────────────────────────────────────────
# Minimum 32-character random strings for token signing & verification
JWT_SECRET=replace_with_a_32_character_long_random_secret_string
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_another_32_character_long_random_secret_string
JWT_REFRESH_EXPIRATION=7d

# ── 5. CLOUDINARY FILE STORAGE (Required for Production Resumes) ───────────────
# Cloudinary credentials for permanent PDF/resume storage on ephemeral servers
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── 6. ADZUNA INTERNSHIP API & CRON (Optional / Recommended) ──────────────────
# Automated job ingestion credentials
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in

# Webhook secret for POST /api/internships/refresh
CRON_SECRET=replace_with_a_secure_random_cron_secret

# ── 7. AI SERVICES (Optional) ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
NVIDIA_API_KEY=your_nvidia_api_key

# ── 8. EMAIL SERVICE (Optional) ───────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="EngineerPath" <noreply@engineerpath.com>

# ── 9. ADMIN SEED CONFIGURATION ───────────────────────────────────────────────
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@engineerpath.com
# Must be at least 12 characters in production
ADMIN_PASSWORD=SetAStrongCustomPassword123!

