# ==============================================================================
# EngineerPath Backend Environment Variables
# ==============================================================================

# ── 1. CORE SERVER CONFIGURATION ──────────────────────────────────────────────
# [Dev]: 5001 | [Prod]: Provided automatically by Render/hosting (e.g. 10000 or 5001)
PORT=5001

# [Dev]: development | [Prod]: production (CRITICAL: enables strict cookie security, CORS & rate limits)
NODE_ENV=development

# URL of the Frontend client allowed for CORS & auth redirects
# [Dev]: http://localhost:5173 | [Prod]: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# URL of the Backend service for file storage paths & webhooks
# [Dev]: http://localhost:5001 | [Prod]: https://your-backend.onrender.com
BACKEND_URL=http://localhost:5001

# Optional comma-separated list of additional allowed CORS origins in production
# ALLOWED_ORIGINS=https://engineerpath.vercel.app,https://your-custom-domain.com

# ── 2. DATABASE (MongoDB Atlas or Local MongoDB) ──────────────────────────────
# Required in production: MongoDB Atlas connection string with readWrite permissions
# [Dev]: mongodb://127.0.0.1:27017/engineerpath
# [Prod]: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/engineerpath?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/engineerpath?retryWrites=true&w=majority

# ── 3. JWT AUTHENTICATION (Required) ──────────────────────────────────────────
# Cryptographically secure random strings (minimum 32 characters, e.g. from `openssl rand -base64 32`)
JWT_SECRET=replace_with_a_32_character_long_random_secret_string
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_another_32_character_long_random_secret_string
JWT_REFRESH_EXPIRATION=7d

# ── 4. CLOUDINARY FILE STORAGE (Required for Production Resumes) ───────────────
# In production, Cloudinary is required to prevent data loss on ephemeral containers.
# In development, falls back to local /uploads if not set.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── 5. ADZUNA INTERNSHIP API & CRON WEBHOOK (Optional / Recommended) ──────────
# Adzuna API credentials for automated internship ingestion
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in

# Shared secret for invoking POST /api/internships/refresh from external schedulers
CRON_SECRET=replace_with_a_secure_random_cron_secret

# ── 6. AI PIPELINES (Optional) ────────────────────────────────────────────────
# Google Gemini API key for dynamic roadmap recommendations & learning features
GEMINI_API_KEY=your_gemini_api_key

# NVIDIA NIM API key for OCR/Vision multimodal resume rasterization
NVIDIA_API_KEY=your_nvidia_api_key

# ── 7. EMAIL SERVICE (Optional) ───────────────────────────────────────────────
# SMTP configuration for verification & transactional emails (e.g. Mailtrap / SendGrid)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="EngineerPath" <noreply@engineerpath.com>

# ── 8. ADMIN SEED CONFIGURATION ───────────────────────────────────────────────
# Used when executing `npm run seed:admin` to initialize the system administrator.
# In production, ADMIN_PASSWORD must be at least 12 characters (default Admin@12345 is blocked).
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@engineerpath.com
ADMIN_PASSWORD=SetAStrongCustomPassword123!

